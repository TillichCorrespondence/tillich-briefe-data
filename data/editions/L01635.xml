    <text type="letter">
        <body>
            <div type="writingSession" n="1">
                <pb n="1"/>
                <opener>R./gr.RGG.–<lb/>Herrn Professor D.Dr. <rs type="person"
                        ref="#tillich_person_id__1928">Paul Tillich</rs>, <hi rend="u">zzt. <rs
                            ref="#tillich_place_id__230" type="place">Kampen</rs></hi><lb/> auf <rs
                        ref="#tillich_place_id__425" type="place">Sylt</rs>, Haus
                            Schulze-Sembten.<dateline><rs ref="#tillich_place_id__448" type="place"
                            >Tübingen</rs>, den <date when="1929-08-22">22. August
                        1929</date>.</dateline><salute>Sehr verehrter <rs
                            ref="#tillich_person_id__1928" type="person">Herr
                        Professor</rs>,</salute></opener>
                <p>mit verbindlichstem Dank für <rs type="letter" ref="L01027">Ihre freundlichen
                        Zeilen vom 20. ds. Mts.</rs> bestätige ich Ihnen den Eingang des Manuskripts
                        <q>Offenbarung, religionsphilosophisch</q>. Dass ich die Manuskripte
                    &quot;Philosophie I und III<supplied>&quot;</supplied> im Laufe des September
                    von Ihnen erwarten darf, habe ich mit Freuden zur Kenntnis genommen. Eine Anzahl
                    Manuskriptblätter zur Niederschrift dieser Artikel schicke ich Ihnen mit
                    gleicher Post.</p>
                <closer>
                    <salute>Mit höflichen Empfehlungen bin ich Ihr ganz ergebener</salute>
                    <signed><hi rend="hand"><rs type="person" ref="#tillich_person_id__1658"
                                >Rühle</rs></hi></signed></closer>
            </div>
        </body>
    </text>
