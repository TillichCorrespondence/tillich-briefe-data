    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <dateline><date when="1947-03-19">March 19, 1947</date>.</dateline><salute>Dear
                            <rs ref="#tillich_person_id__1928" type="person">Professor
                        Tillich</rs>:</salute>
                </opener>
                <p><rs ref="#tillich_person_id__4724" type="person">Dr. Emile Kauder</rs> has
                    applied for a position with us as head of our Department of Economics. We would
                    greatly appreciate your frank appraisal of the adequacy of his training, his
                    effectiveness as a teacher, and his personal suitability for membership on the
                    faculty of a church college.</p>
                <p>Any information you may provide us will be treated with complete confidence.</p>
                <closer>
                    <salute>Sincerely yours,</salute>
                    <signed>
                        <hi rend="hand"><rs ref="#tillich_person_id__4952" type="person">A. A.
                                Schoolcraft</rs></hi><lb/><rs ref="#tillich_person_id__4952"
                            type="person">A. A. Schoolcraft</rs><lb/>Dean</signed>
                </closer>

            </div>
        </body>
    </text>
