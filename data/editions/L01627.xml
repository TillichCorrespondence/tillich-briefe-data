    <text type="letter">
        <body>
            <div type="writingSession" n="1">
                <pb n="1"/>
                <p>Hierdurch bitte ich Sie, um Zusendung von fünf Exemplaren meiner Schrift <q><rs
                        type="work" ref="#tillich__G8CYBFWE">Über das Dämonische</rs></q> zum
                    Autorenpreis.</p>
                <closer>
                    <salute>Ergebenst</salute>
                    <signed>Professor D. Dr. <rs type="person" ref="#tillich_person_id__1928">Paul
                            Tillich</rs><lb/>Elisenstr. 11<lb/><rs ref="#tillich_place_id__126"
                            type="place">Dresden</rs><lb/><hi rend="hand"><rs type="person"
                                ref="#tillich_person_id__1928">Tillich</rs></hi><note type="ea">Die
                            Postkarte trägt den Posteingangsstempel: <q>4. Post <date
                                    when="1928-06-28">28. JUNI 1928</date></q> sowie den
                            Bearbeitungsstempel: <q><date when="1928-06-29">29. Juni
                            1928</date></q>.</note></signed>
                </closer>
            </div>
        </body>
    </text>
