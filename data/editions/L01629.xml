    <text type="letter">
        <body>
            <div type="writingSession" n="1">
                <pb n="1"/>
                <opener><dateline><rs ref="#tillich_place_id__126" type="place">Dresden</rs>,
                        Elisenstr. 11., d. <date when="1926-02-13"
                        >13.II.26</date>.</dateline><salute>Sehr verehrter <rs
                            ref="#tillich_person_id__4713" type="person">Herr
                    Kollege</rs>!</salute></opener>
                <p>Darf ich Sie bitten, den Artikel über <hi rend="u"><rs
                            ref="#tillich_person_id__444" type="person">Dehn</rs></hi> und <hi
                        rend="u"><rs ref="#tillich_person_id__2463" type="person">Fuchs</rs></hi>
                    jemand anders zu übergeben, da mir eine solche biographische Skizze nicht liegt
                    und unverhältnismäßig viel Arbeit machen würde? In Betracht käme vielleicht Lic.
                        <hi rend="uu"><rs ref="#tillich_person_id__1696" type="person"
                        >Schafft</rs></hi>, <rs ref="#tillich_place_id__236" type="place"
                        >Kassel</rs>, Sternstr. 4.</p>
                <closer>
                    <salute>Ihr sehr ergebener</salute>
                    <signed><rs type="person" ref="#tillich_person_id__1928">P.
                        Tillich</rs>.</signed></closer>
            </div>
        </body>
    </text>
