   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <p><rs ref="#tillich_person_id__1923" type="person"><rs ref="#tillich_person_id__1928" type="person">Professor and Mrs. Tillich</rs></rs>
            cordially invite the members of the Columbia-Union Discussion Group, <hi rend="underline">with their wives</hi>,
            to an At Home in their new apartment, 711 McGiffert Hall, 99 Claremont Avenue, on Friday,
            December 13th, at 8:15 P. M..</p>
            <p><rs ref="#tillich_person_id__1829" type="person">Dr. Friedrich Spiegelberg</rs>, who
               will leave shortly for the Pacific School of Religion, will read a paper on
                  <q>Alchemy as a Way of Salvation.</q>
            </p>
            
            <closer>
               R. S. V. P. to <rs ref="#tillich_person_id__1923" type="person">Mrs. Tillich</rs> at your earliest
               convenience.
            </closer>
         </div>
      </body>
   </text>
