    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><dateline><date when="1945-11-03">November 3, 1945</date></dateline>
                    <salute>Dear <rs ref="#tillich_person_id__3341" type="person"
                        >Cyril</rs>:</salute></opener>
                <p><rs ref="#tillich_person_id__3474" type="person">Mr. Morris</rs>, a refugee who
                    gave me the three book-titles enclosed is very well acquainted with progressive
                    French Catholicism. I do not know whether it is worthwhile to ask the library to
                    buy these books. If you yourself have no <sic>judgement</sic> do you know
                    somebody whom we could ask?</p>
                <closer><salute>Yours,</salute><signed><rs ref="#tillich_person_id__1928"
                            type="person">Paul Tillich</rs></signed>
                </closer>
            </div>
        </body>
    </text>
