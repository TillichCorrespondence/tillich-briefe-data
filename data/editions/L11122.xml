    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><dateline><date when="1948-01-16">January 16, 1948</date></dateline>
                    <salute>Dear <rs ref="#tillich_person_id__608" type="person">Dr.
                        Fox</rs>:</salute>
                </opener>
                <p><rs ref="#tillich_person_id__1928" type="person">Dr. Tillich</rs> who is still on
                    his sabbatical leave, asked me to answer <rs ref="L11121" type="letter">your
                        kind letter of January 9th</rs>.</p>
                <p>He only knows about <rs ref="#tillich_person_id__4764" type="person">Dr.
                        Baeck</rs> but is not well acquainted with <rs
                        ref="#tillich_person_id__4764" type="person">Dr. Baeck</rs>. For that reason
                    he feels unable to write a letter to <rs ref="#tillich_person_id__4765"
                        type="person">Dr. Ernest Colwell</rs>. But he suggests that you approach <rs
                        ref="#tillich_person_id__5073" type="person">Dr. Louis Finkelstein</rs> of
                    the Jewish Theological Seminary, Broadway at 122 Street, <rs
                        ref="#tillich_place_id__319" type="place">New York</rs> 27, <rs
                        ref="#tillich_place_id__865" type="place">N. Y.</rs>
                    <rs ref="#tillich_person_id__5073" type="person">Dr. Finkelstein</rs>, he is
                    convinced, is well acquainted with <rs ref="#tillich_person_id__4764"
                        type="person">Dr. Baeck</rs> and his work.</p>
                <closer>
                    <salute>Sincerely yours,</salute>
                    <signed><rs ref="#tillich_person_id__4907" type="person">Secretary to Dr.
                            Tillich</rs></signed></closer>
            </div>
        </body>
    </text>
