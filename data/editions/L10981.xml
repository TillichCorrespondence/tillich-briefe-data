    <text type="telegram">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <dateline>NJ28 36=<rs ref="#tillich_place_id__1044" type="place">CLINTON</rs>
                    <rs ref="#tillich_place_id__726" type="place">CONN</rs>
                    <date when="1946-08-20">AUG 20</date> 1025A <lb/><rs
                        ref="#tillich_person_id__1928" type="person">PAUL TILLICH</rs>= <lb/>GENERAL
                    DELIVERY <rs ref="#tillich_place_id__769" type="place">EAST HAMPTON</rs> LI <rs
                        ref="#tillich_place_id__865" type="place">NY</rs>= </dateline>
                <p>WHEN WE SAW YOU LAST WE FELT THAT OUR FRIEND <rs ref="#tillich_person_id__1928"
                        type="person">PAULUS</rs> STARTED A NEW CHAPTER OF HIS LIFE AND WORKS IT
                    COINCIDES WITH YOUR 60TH BIRTHDAY TO WHICH WE CONGRATULATE YOU IN LOVE AND DEEP
                    ADMIRATION=</p>
                <closer>
                    <signed><rs ref="#tillich_person_id__1844" type="person">ELSE</rs> AND <rs
                            ref="#tillich_person_id__1845" type="person">HANS
                        STAUDINGER</rs>.</signed>
                    <lb/>1050A</closer>
                <!-- Am unteren linken Blattrand: <rs ref="#tillich_person_id__1928" type="person">PAULUS</rs> 60 <rs
                        ref="#tillich_person_id__1844" type="person">ELSE</rs>. -->
            </div>
        </body>
    </text>
