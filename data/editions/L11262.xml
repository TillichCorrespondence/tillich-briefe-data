   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><dateline><date when="1948-11-29">November 29, 1948</date></dateline>
               <lb/><rs ref="#" type="person">Dr. Paul Tillich</rs>.<lb/>
               Union Theological Seminary,<lb/>
               <rs ref="#tillich_place_id__319" type="place">New York City, N.Y.</rs>
               <salute>Dear <rs ref="#tillich_person_id__1928" type="person">Dr.
                  Tillich</rs>:</salute>
            </opener>
            <p><rs ref="#tillich_person_id__5390" type="person">Dr. Israel Bettan</rs> mentioned to me that you
            were a little uncertain as to the arrangements for your visit here under the 
            <rs ref="#tillich_person_id__5391" type="person">Jeannette Miriam Goldberg</rs> Lectureship.</p>
            <p>I am enclosing copies of our previous correspondence with you. I hope that this will
            answer you questions.</p>
            <p><rs ref="#tillich_person_id__5390" type="person">Dr. Bettan</rs> suggested that you might choose a subject
            connected with the philosophy of history to speak on.</p>
            <closer>
               <salute>Sincerely yours,</salute>
               <signed><rs ref="#tillich_person_id__5389" type="person"
                  ><hi rend="hand">Bertram W. Korn</hi><lb/>Rabbi Bertram W. Korn</rs><lb/>Assistant to the President</signed>
            </closer>
         </div>
      </body>
   </text>
