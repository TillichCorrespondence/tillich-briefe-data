    <text type="letter">
        <body>
            <div type="writingSession" n="1">
                <pb n="1"/>
                <opener>R./gr.RGG.–<lb/>Herrn Professor D.Dr. <rs type="person"
                        ref="#tillich_person_id__1928">Paul Tillich</rs>,<lb/> bei Herrn Pfarrer
                    Lic. <rs type="person" ref="#tillich_person_id__1154">Leese</rs>, <hi rend="u"
                            ><hi rend="g"><rs ref="#tillich_place_id__198" type="place"
                            >Hamburg</rs></hi></hi>.<lb/> Koppel 11.<dateline><rs
                            ref="#tillich_place_id__448" type="place">Tübingen</rs>, den <date
                            when="1929-09-21">21. September 1929</date>.</dateline><salute>Sehr
                        verehrter <rs ref="#tillich_person_id__1928" type="person">Herr
                            Professor</rs>,</salute></opener>
                <p>in Beantwortung <rs type="letter" ref="L01634">Ihrer freundlichen Karte vom 19.
                        ds. Mts.</rs> gestatte ich mir, Ihnen mitzuteilen, dass ich in letzter Zeit
                    eine Korrektursendung Ihres Artikels <q>Offenbarung</q> für RGG nicht an Sie
                    gerichtet habe, wie ich mich überhaupt nicht entsinnen kann, in den letzten
                    Wochen ein Schreiben an Sie gerichtet zu haben.</p>
                <closer>
                    <salute>Mit freundlichen Empfehlungen bin ich Ihr ganz ergebener</salute>
                    <signed><hi rend="hand"><rs type="person" ref="#tillich_person_id__1658"
                                >Rühle</rs></hi></signed></closer>
            </div>
        </body>
    </text>
