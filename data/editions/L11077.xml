    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <dateline><date when="1947-04-19">April 19, 1947</date></dateline><salute>Dear
                            <rs ref="#tillich_person_id__1928" type="person">Professor
                        Tillich</rs>:</salute>
                </opener>
                <p><rs ref="#tillich_person_id__4959" type="person">Charles Libby Ives</rs> has
                    applied for admission to this School and has given us your name as a reference.
                    Will you kindly write us at length concerning him, stating your opinion of his
                    scholastic ability? We also particularly request full and frank information
                    concerning his personality, his moral character, and his promise of usefulness
                    in Christian service. Your reply will of course be treated as confidential.</p>
                <p>An early answer would be greatly appreciated.</p>
                <closer>
                    <salute>Very sincerely yours,</salute>
                    <signed>
                        <hi rend="hand"><rs ref="#tillich_person_id__4958" type="person">L. A.
                                Weigle</rs></hi><lb/>Dean</signed>
                </closer>

            </div>
        </body>
    </text>
