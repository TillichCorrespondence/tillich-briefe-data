    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <dateline><date when="1947-04-03">April 3, 1947</date></dateline><salute>Dear
                            <rs ref="#tillich_person_id__1928" type="person">Professor
                        Tillich</rs>;</salute>
                </opener>
                <p><rs ref="L11055" type="letter">Your letter in support of</rs>
                    <rs ref="#tillich_person_id__228" type="person">Dr. Ernest Bloch</rs>&apos;s
                    application for grant in aid from Bollingen Foundation has been received. Thank
                    you for your valuable estimate of <rs ref="#tillich_person_id__228"
                        type="person">Dr. Bloch</rs>&apos;s qualifications. I wish to assure you, in
                    behalf of the Trustees of the Foundation, that your recommendation will receive
                    the most careful consideration.</p>
                <closer>
                    <salute>Sincerely yours,</salute>
                    <signed>
                        <hi rend="hand"><rs ref="#tillich_person_id__4954" type="person">John D.
                                Barrett</rs></hi><lb/><rs ref="#tillich_person_id__4954"
                            type="person">John D. Barrett</rs><lb/>Editor</signed>
                </closer>
            </div>
        </body>
    </text>
