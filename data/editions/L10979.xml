    <text type="telegram">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <dateline>NG163 NL PD=<rs ref="#tillich_place_id__768" type="place"
                            >SANFRANCISCO</rs>
                        <rs ref="#tillich_place_id__848" type="place">CALIF</rs>
                        <date when="1946-08-19">AUG 19</date>
                        <lb/><rs ref="#tillich_person_id__1928" type="person">PAUL TILLICH</rs>=
                        <lb/>GENERAL DELIVERY <rs ref="#tillich_place_id__769" type="place"
                            >EASTHAMPTON</rs>
                        <rs ref="#tillich_place_id__865" type="place">NY</rs>= </dateline>
                </opener>
                <p>CONGRATULATIONS PLENTY. LIFE STARTS AT THRICE TWENTY WINE AND SONG AND GOUGH.</p>
                <closer><salute>WISH YOU</salute>
                    <signed><rs ref="#tillich_person_id__1209" type="person">A</rs> AND <rs
                            ref="#tillich_person_id__1210" type="person">B</rs>= = =
                        <lb/>LOWE</signed></closer>
                <!--Am unteren linken Blattrand: <rs ref="#tillich_person_id__1209" type="person">A</rs> AND <rs
                        ref="#tillich_person_id__1210" type="person">B</rs>-->
            </div>
        </body>
    </text>
