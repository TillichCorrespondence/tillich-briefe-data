    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <salute>Lieber <rs ref="#tillich_person_id__1928" type="person"
                        >Freund</rs>!</salute>
                </opener>
                <p><rs ref="#tillich_person_id__4957" type="person">Mrs. Lili Carey</rs> möchte
                    Ihnen von<pb n="2"/>
                    <rs ref="#tillich_place_id__122" type="place">Deutschland</rs> erzählen,
                        <unclear>wo</unclear> sie herkommt. Ich empfehle Ihnen, <rs
                        ref="#tillich_person_id__4957" type="person">Mrs. Carey</rs> eine Stunde
                    eingehender Unterhaltung zu widmen. Sie ist mir von Freunden empfohlen.</p>
                <closer>
                    <signed><rs ref="#tillich_person_id__4925" type="person"
                            >PK</rs></signed><dateline><date when="1947-04-17"
                        >17.4.1947</date></dateline>
                </closer>

            </div>
        </body>
    </text>
