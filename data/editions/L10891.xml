            <div type="writingSession">
                <pb n="1"/>
                <p><rs ref="#tillich_person_id__627" type="person">Mr.</rs> and <rs
                        ref="#tillich_person_id__3390" type="person">Mrs. Walter Friedlander</rs>
                    <lb/>announce the marriage of their daughter <lb/><rs
                        ref="#tillich_person_id__3391" type="person">Dorothee</rs>
                    <lb/>to <lb/><rs ref="#tillich_person_id__3392" type="person">Mr. Albert
                        Mindlin</rs>
                    <lb/>on <date when="1946-02-08">the eighth of February <lb/>Nineteen hundred and
                        forty-six</date>
                    <lb/><rs ref="#tillich_place_id__815" type="place">Berkeley</rs>, <rs
                        ref="#tillich_place_id__848" type="place">California</rs></p>
            </div>
