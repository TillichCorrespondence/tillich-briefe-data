    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><fw place="top" type="adressline"><rs ref="#tillich_person_id__3342"
                            type="person">Mr. Edward Morris</rs>
                        <lb/>404 A Yale Station <lb/><rs ref="#tillich_place_id__770" type="place"
                            >New Haven</rs>, <rs ref="#tillich_place_id__726" type="place"
                            >Conn.</rs></fw><dateline><date when="1946-04-12">April 12,
                        1946</date></dateline>
                    <salute>Dear <rs ref="#tillich_person_id__3342" type="person">Mr.
                        Morris</rs>:</salute></opener>
                <p><rs ref="#tillich_person_id__1928" type="person">Prof. Tillich</rs> who is out of
                    town for a few days asked me to answer your <rs ref="#L10929" type="letter"
                        >letter of April 10th</rs>.</p>
                <p>All evenings in April are taken but he would like to come to <rs
                        ref="#tillich_place_id__770" type="place">New Haven</rs>
                    <date from="1946-05-06" to="1946-05-12">the week of May 6th</date>. As soon as
                    he is back he shall write to you again.</p>
                <closer><salute>Yours sincerely,</salute><signed>Secretary to <rs
                            ref="#tillich_person_id__1928" type="person">Prof. Tillich
                        </rs></signed>
                </closer>
            </div>
        </body>
    </text>
