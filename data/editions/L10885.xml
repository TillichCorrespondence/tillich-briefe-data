    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><dateline><date when="1945-12-22">December 22, 1945</date></dateline>
                    <salute>Dear <rs ref="#tillich_person_id__3381" type="person">Mrs.
                        Oertly</rs>:</salute></opener>
                <p>I have received the enclosed letter from <rs ref="#tillich_person_id__210"
                        type="person">Prof. Bewer</rs>.<note type="ea">Liegt nicht vor.</note> I
                    think the idea to get in touch with <rs ref="#tillich_person_id__3382"
                        type="person">Prof. Fife</rs> is a very good one. If you do not like to do
                    it directly I shall be glad to do it for you. Please let me know.</p>
                <closer><salute>Cordially yours,</salute><signed><rs ref="#tillich_person_id__1928"
                            type="person">Prof. Paul Tillich</rs></signed>
                </closer>
                <postscript>
                    <p>P. S. How did you like <rs ref="#tillich_person_id__3383" type="person"
                            >Blanchards</rs>
                        <!-- denkbar, dass Brand Blanshard (ref="#tillich_person_id__226") gemeint war. -->
                            p<supplied>a</supplied>per?</p>
                </postscript>
            </div>
        </body>
    </text>
