   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><lb/> C.V.Allert de Lange.<lb/>Damrack 62 <lb/>
               <rs ref="#tillich_place_id__12" type="place">Amsterdam</rs> /C
                     <lb/><lb/><dateline><date when="1940-01-17">January 17 th 40</date>.</dateline>
               <salute>Sehr geehrter <rs ref="#tillich_person_id__" type="person">Herr de
                  Lange</rs>,<!-- siehe oben de Lange ist der Verlagsname -->,</salute>
            </opener>
            <p><rs ref="#tillich_person_id__1928">Herr Prof. Tillich</rs> bittet mich, Ihnen
               mitzuteilen, dass die Kriegssituation eine solche Umdenkung der ganzen Dinge gemacht
               hat, dass er noch den Sommer haben muss, um das Werk zu vollenden und wohl nicht vor
               September das Manuskript schicken wird. Er arbeitet aber inzwischen ununterbrochen an
               den Problemen der religioes-politischen Neugestaltung, die dem Buch sicher zu gute
               kommen werden.</p>
            <closer>
               <salute>Mit besten Gruessen</salute>
               <signed><rs ref="#tillich_person_id__3339" type="person"
                  ><hi rend="hand">Hilde Frankel</hi></rs><lb/> Secretary to <rs rend="#tillich_person_id__1928" type="person">Prof. Tillich</rs>.</signed>
            </closer>
         </div>
      </body>
   </text>
