   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><dateline><date when="1939-11-24">November 24 th 39</date></dateline>
               <lb/> Allert de Lange <lb/>Damrack 62 <lb/>
               <rs ref="#tillich_place_id__12" type="place">Amsterdam</rs> C <lb/>
               <rs ref="#tillich_place_id__818" type="place">Holland</rs>
               <salute>Dear <rs ref="#tillich_person_id__" type="person">Mr. de
                  Lange</rs>,<!-- siehe oben de Lange ist der Verlagsname -->,</salute>
            </opener>
            <p><rs ref="#tillich_person_id__1928" type="person">Prof. Dr. Tillich</rs> wrote a few
               weeks ago to you about his work <q>Religion and world politics.</q> Since he did not
               hear from you I would appreciate it very much if you could tell me if you got his
               letter and about your intentions.</p>
            <closer>
               <salute>Very respectfully yours</salute>
               <signed><rs ref="#tillich_person_id__3339" type="person"
                  ><hi rend="hand">Hilde Frankel</hi></rs><lb/> Secretary to <rs rend="#tillich_person_id__1928" type="person">Prof. Tillich</rs>.</signed>
            </closer>
         </div>
      </body>
   </text>
