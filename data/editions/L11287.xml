   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><dateline><date when="1949-03-05">March 5, 1949</date></dateline><lb/>
               <rs ref="#tillich_person_id__5380" type="person">President Nelson Glueck</rs><lb/>
               The Hebrew Union College<lb/>
               <rs ref="#tillich_place_id__807" type="place">Cincinnati, Ohio</rs>
               <salute>Dear <rs ref="#tillich_person_id__5380" type="person">President
                  Glueck</rs>:</salute>
            </opener>
            <p><rs ref="#tillich_person_id__1928" type="person">Prof. Tillich</rs> who is just leaving
            town for a few days asked me to write you that he fully agrees with your suggestion and that
            he has reduced his lectures to three, namely the following:</p>
            <p><hi rend="underline">Urgent Problems of Present Day Theology</hi></p>
            <p>1) Union or Separation of Religion and Culture</p>
            <p>2) Message and Myth in the Biblical Literature</p>
            <p>3) Authority and Criticism in Religion and Theology.</p>
            <closer>
               <salute>Sincerely yours,</salute>
               <signed>Secretary to <rs ref="#tillich_person_id__1928" type="person"
                  >Prof. Tillich</rs></signed>
            </closer>
         </div>
      </body>
   </text>
