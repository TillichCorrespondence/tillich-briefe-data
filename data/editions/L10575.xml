   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><dateline><date when="1942-06-01">1. Juni, 1942</date></dateline>
               <salute>Sehr geehrter <rs ref="#tillich_person_id__1928" type="person">Herr
                  Professor</rs>:</salute>
            </opener>
            <p>Samstag, den 6. Juni faehrt <rs ref="#tillich_person_id__313" type="person">Herr Budzislawski</rs> nach <rs
             ref="#tillich_place_id__1351" type="place">Twin Farms, South Pomfret, Vermont</rs> (telephone: Bethel
             81). Er hat mich ersucht, Ihnen das mitzuteilen und Sie zu bitten von Montag, den 8.
             Juni angefangen, Ihr MS allwoechentlich montags vormittag an ihn abzusenden.</p>
            <closer>
               <salute>Mit bestem Gruss,</salute>
               <signed><rs ref="#tillich_person_id__99" type="person"
                  ><hi rend="hand">Hilda Auersperg</hi></rs></signed>
            </closer>
         </div>
      </body>
   </text>
