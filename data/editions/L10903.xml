    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><fw place="top" type="letterhead"><rs ref="#tillich_person_id__3451"
                            type="person">ELSE FARMER</rs>, M. D. <lb/>33 ARRANDALE AVENUE <lb/><rs
                            ref="#tillich_place_id__828" type="place">GREAT NECK</rs>, <rs
                            ref="#tillich_place_id__865" type="place">N. Y.</rs>
                        <lb/><!-- Dazwischen Strich --><rs ref="#tillich_place_id__828" type="place"
                            >GREAT NECK</rs> 4444 </fw><dateline><date when="1946-01-23">1/23,
                            46</date>.</dateline><salute>Dear <rs ref="#tillich_person_id__1928"
                            type="person">Paulus</rs>,</salute>
                </opener>
                <p>The son of a very good friend of mine, <rs ref="#tillich_person_id__3452"
                        type="person">Hans Langstadt</rs>, just back from overseas, is going to ask
                    your advice in religious matters. I am sure you can help him.</p>
                <closer><salute>Thank you and greetings</salute><signed><rs
                            ref="#tillich_person_id__3451" type="person">Else F.</rs></signed>
                </closer>
                <postscript>
                    <p>And call after <unclear><rs ref="#tillich_person_id__1923" type="person">Mrs
                                Tillich</rs></unclear>
                    </p>
                </postscript>
            </div>
        </body>
    </text>
