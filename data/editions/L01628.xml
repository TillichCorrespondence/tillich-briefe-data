            <div type="writingSession" n="1">
                <pb n="1"/>
                <p>Hierdurch bitte ich um übersendung von 3 Exemplaren des <q><rs type="work"
                            ref="#tillich__G8CYBFWE">Dämonischen</rs></q> zum Autorenpreis.</p>
                <closer>
                    <salute>Ergebenst</salute>
                    <signed><hi rend="hand">Prof. D. <rs type="person"
                                ref="#tillich_person_id__1928">P.
                    Tillich</rs>.</hi></signed></closer>
                <dateline><rs ref="#tillich_place_id__126" type="place">Dr</rs>. <date
                        when="1928-02-21">21.2.28</date>.<note type="ea">Die Postkarte trägt den
                        Posteingangsstempel: <q>1. Post <date when="1928-02-23">23. FEB.
                            1928</date></q> sowie den Bearbeitungsstempel: <q><date
                                when="1928-02-24">24. Feb. 1928</date></q>.</note></dateline>


            </div>
