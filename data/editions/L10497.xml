   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener>
               <dateline><date when="1940-08-14">August 14, 1940</date></dateline>
               <salute>Dear <rs ref="#tillich_person_id__1928" type="person">Paul</rs>:</salute>
            </opener>
            <p>Since receiving your letter of July 20<note type="ea">liegt nicht vor</note> I have
               had the opportunity of talking with <rs ref="#tillich_person_id__4437" type="person"
                  >Dr. Landis</rs>
               <!-- Zuordnung unklar --> about the proposed project for research on anti-Semitism by
                  <rs ref="#tillich_person_id__931" type="person">director</rs> of the International
               Institute of Social Research. I am glad to report that <rs
                  ref="#tillich_person_id__4437" type="person">Dr. Landis</rs> is impressed with the
               proposal and has so advised his friends in the American Jewish Committee.</p>
            <closer>
               <salute>With warm regards, I remain<lb/>Cordially yours,</salute>
               <signed><rs ref="#tillich_person_id__4027" type="person"
                  ><hi rend="hand">Samuel McCrea Cavert</hi><lb/>SAMUEL MC CREA CAVERT</rs><lb/>
               General Secretary</signed><lb/>
               <rs ref="#tillich_person_id__1928" type="person">Professor Paul Tillich</rs><lb/>
               General Delivery<lb/>
               <rs ref="#tillich_place_id__831" type="place">Carmel by the Sea</rs><lb/>
               <rs ref="#tillich_place_id__848" type="place">CALIFORNIA</rs>
            </closer>
         </div>
         <div type="writingSessioncopy">
            <pb n="1"/>
            <opener><hi rend="underline">Copy</hi><lb/>
               The Federal <hi rend="s"></hi><add place="superlinear"><hi rend="hand">Council</hi> if the Churches of Christ in America.<lb/>
               </add><dateline><date when="1940-08-14">August 14, 1940</date></dateline>
               <salute>Dear <rs ref="#tillich_person_id__1928" type="person">Paul</rs>:</salute>
            </opener>
            <p>Since receiving your letter of July 20<note type="ea">liegt nicht vor</note> I have
               had the opportunity of talking with <rs ref="#tillich_person_id__4437" type="person"
                  >Dr. Landis</rs>
               <!-- Zuordnung unklar --> about the proposed project for research on anti-Semitism by
               <rs ref="#tillich_person_id__931" type="person">director</rs> of the International
               Institute of Social Research. I am glad to report that <rs
                  ref="#tillich_person_id__4437" type="person">Dr. Landis</rs> is impressed with the
               proposal and has so advised his friends in the American Jewish Committee.</p>
            <closer>
               <salute>With warm regards, I remain<lb/>Cordially yours,</salute>
               <signed><rs ref="#tillich_person_id__4027" type="person"
                  ><hi rend="hand">Samuel McCrea Cavert</hi><lb/>SAMUEL MC CREA CAVERT</rs><lb/>
                  General Secretary</signed><lb/>
               <rs ref="#tillich_person_id__1928" type="person">Professor Paul Tillich</rs><lb/>
          
               <rs ref="#tillich_place_id__831" type="place">Carmel by the Sea</rs><lb/>
             
            </closer></div>
         
      </body>
   </text>
