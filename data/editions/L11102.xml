    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><salute>Dear <rs ref="#tillich_person_id__1213" type="person"
                        >Leo</rs>:</salute>
                </opener>
                <p>Many thanks for <rs type="letter" ref="L11100">your letter</rs>! I am glad you
                    will come in September! <rs
                        ref="#tillich_person_id__931 #tillich_person_id__931" type="person">The
                        Roberts</rs> will be here to at least the <date when="1947-09-15">15<hi
                            rend="sup">th</hi></date><supplied>.</supplied>
                    <rs ref="#tillich_person_id__1927" type="person">René</rs> will come the <date
                        when="1947-09-06">6<hi rend="sup">th</hi></date>
                    <del rend="s">and</del>
                    <add place="superlinear">or</add>
                    <date when="1947-09-07">7<hi rend="sup">th</hi></date> and sleep somewhere.
                    Nothing is decided about <rs ref="#tillich_person_id__1923" type="person"
                        >Hannah</rs>. <hi rend="u">After</hi> the <date when="1947-09-15">15<hi
                            rend="sup">th</hi></date> you can stay in our home!
                        <unclear>¿¿¿</unclear> weekend is all right with me. Please write when you
                    are <unclear>¿¿¿</unclear> from <rs ref="#tillich_place_id__854" type="place"
                        >Bar Harbor</rs>.</p>
                <closer><salute>Yours</salute><signed><rs ref="#tillich_person_id__1928"
                            type="person">Paulus</rs></signed></closer>
            </div>
        </body>
    </text>
