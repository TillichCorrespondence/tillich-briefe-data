    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener>
                    <dateline><date when="1947-01-14">January 14, 1947</date></dateline>
                    <salute>Dear Sir:</salute>
                </opener>
                <p>In applying for a position with us <rs ref="#tillich_person_id__2690"
                        type="person">Miss Mary Jacker</rs> has given us your name as reference.</p>
                <p>Any information which you may care to give us regarding her character,
                    responsibility and general comportment will be greatly appreciated and held in
                    strict confidence. </p>
                <closer>
                    <salute>Yours very truly,</salute>
                    <signed><rs type="person"><unclear>¿¿¿</unclear></rs><lb/>Treasurer. </signed>
                </closer>
            </div>
        </body>
    </text>
