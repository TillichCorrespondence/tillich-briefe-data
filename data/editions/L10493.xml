   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener><rs ref="#tillich_person_id__4026" type="person">PAUL ZUCKER</rs>
               <lb/> 103-107 EAST 55TH STREET <lb/><rs ref="#tillich_place_id__319" type="palce">NEW
                  YORK CITY</rs>
               <lb/>ELDORADO 5-1326 <salute>Lieber <rs ref="#tillich_person_id__1928" type="person"
                     >Herr Dr</rs>!</salute>
            </opener>
            <p>Zu Ihrem Ehrendoktor<!-- 1940 erhielt Tillich einen Ehrendoktor von der Yale University  --> meine
               herzlichsten Glückwünsche. Mit der gesamten Emigration fühle ich mich mit
                  <unclear>geehrt</unclear>! Ich wünsche Ihnen herzlichst weiter ersprießliches
               Wirken für Sie selbst und Ihre Klienten!</p>
            <closer>
               <salute>Mit bestem Gruß</salute>
               <signed>Ihr <unclear>getreuer</unclear><rs ref="#tillich_person_id__4026"
                     type="person">Paul Zucker</rs></signed>
               <dateline><date>2<unclear>1</unclear> Juni 1940</date>.</dateline>
            </closer>
         </div>
      </body>
   </text>
