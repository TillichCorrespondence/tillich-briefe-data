    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><fw place="top" type="letterhead">INDIANA UNIVERSITY <lb/>DEPARTMENT OF
                        PHILOSOPHY <lb/><rs ref="#tillich_place_id__1083" type="place"
                            >BLOOMINGTON</rs>, <rs ref="#tillich_place_id__695" type="place"
                            >INDIANA</rs></fw>
                    <dateline>Holland, Mich. R. 4 <lb/><date when="1946-08-22">August 22,
                            1946</date></dateline>
                    <salute>Dear <rs ref="#tillich_person_id__1928" type="person">Professor
                            Tillich</rs>,</salute>
                </opener>
                <p>Thank you for your discerning letter of recommendation for Dr. <rs
                        ref="#tillich_person_id__3989" type="person">William Young</rs> of <rs
                        ref="#tillich_place_id__1082" type="place">Toronto</rs>.<note type="ea"
                        >Liegt nicht vor.</note> I hope that he may be with us on our staff at <rs
                        ref="#tillich_place_id__695" type="place">Indiana</rs> next
                    year.<!-- wahrscheinlich ist die Indiana University gemeint --></p>
                <closer>
                    <salute>Sincerely,</salute>
                    <signed><rs ref="#tillich_person_id__3988" type="person">W. H. Jellema</rs>
                        <lb/><rs ref="#tillich_person_id__3988" type="person">W. H. Jellema</rs>
                        <!-- Unterschrift, dann gedruckt. --></signed>
                </closer>
            </div>
        </body>
    </text>
