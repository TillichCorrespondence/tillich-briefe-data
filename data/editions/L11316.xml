    <text type="letter">
        <body>
            <div type="writingSession">
                <pb n="1"/>
                <opener><salute>Dear Sir:</salute>
                </opener>
                <p>I have received the enclosed letter from a <rs type="person">friend of
                        mine</rs>.<note type="ea">Konnte nicht ermittelt werden.</note> I am writing
                    whether there is a couple among the recent newcomers who would fill the job.</p>
                <p>Would you kindly contect <rs type="person" ref="#tillich_person_id__5495">Mrs.
                        Lee</rs> directly if you have some suggestions. If not, please return the
                    letter to me.</p>
                <closer><salute>Sincerely yours,</salute><signed><rs type="person"
                            ref="#tillich_person_id__1928">Prof. Paul Tillich</rs></signed>
                </closer>
            </div>
        </body>
    </text>
