   <text type="letter">
      <body>
         <div type="writingSession">
            <pb n="1"/>
            <opener>
               <salute>Liebe <rs ref="#tillich_person_id__932" type="person"><rs ref="#tillich_person_id__931" type="person">Horkeimer</rs></rs>,</salute>
            </opener>
            <p>Wir denken viel an Euch und <rs ref="#tillich_person_id__1521" type="person">Fritz
                  Pollock</rs> und wünschten, Ihr wäret hier! Mit den <rs
                  ref="#tillich_person_id__570" type="person"><rs ref="#tillich_person_id__1927"
                     type="person">Kindern</rs></rs> in den Bergen zu sein ist ganz wunderbar. – Am
               22. sind wir in <rs ref="#tillich_place_id__319" type="place">New York</rs></p>
            <closer>
               <salute>Eure</salute>
               <signed><rs ref="#tillich_person_id__1928" type="person"
                  >Paulus</rs> <rs ref="#tillich_person_id__1923" type="person"
                     >Hannah</rs></signed>
            </closer>
         </div>
      </body>
